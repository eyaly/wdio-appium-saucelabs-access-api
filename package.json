{
  "name": "wdio-appium-saucelabs-access-api",
  "version": "1.0.0",
  "description": "WebdriverIO + Sauce Labs Real Device Access API: PawKnits iOS login with live network capture",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.access-api.conf.js",
    "test:all-traffic": "NETWORK_FILTER= wdio run ./config/wdio.access-api.conf.js",
    "test:debug-network": "NETWORK_DEBUG=1 wdio run ./config/wdio.access-api.conf.js"
  },
  "devDependencies": {
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "async-exit-hook": "^2.0.1",
    "ws": "^8.23.0"
  },
  "license": "MIT"
}
