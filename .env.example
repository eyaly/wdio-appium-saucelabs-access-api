# Copy to .env and fill in. Never commit .env.
# SAUCE_USERNAME / SAUCE_ACCESS_KEY can also come from system environment variables.
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=

# Data center: eu-central-1 (default) | us-west-1 | us-east-4  (EU_CENTRAL / US_WEST also work)
# SAUCE_REGION=eu-central-1

# PawKnits IPA in Sauce Labs App Storage
IOS_APP=storage:filename=PawKnits.ipa
# IOS_BUNDLE_ID=com.pawknits.demo

# Device: exact name or regex (e.g. iPhone_16_real or iPhone.*). Empty = any iOS device.
# IOS_DEVICE=iPhone.*

# Optional
# SAUCE_BUILD_NAME=
# SAUCE_TEST_NAME=
# APPIUM_VERSION=latest        # hosted Appium server version
# ACCESS_API_SESSION_DURATION=PT30M   # safety net: the device is released after this even if the run dies

# SAUCE_API_URL=                # overrides the API host for the region (non-standard endpoints)
